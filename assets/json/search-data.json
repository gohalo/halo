{{- /* FlexSearch 索引数据：{"/页面路径/": {"title": 标题, "data": {"#片段": 文本}}} */ -}}
{{- $flexsearch := dict -}}
{{- with site.Params.search -}}{{- with .flexsearch -}}{{- $flexsearch = . -}}{{- end -}}{{- end -}}
{{- $indexType := $flexsearch.index | default "content" -}}

{{- if not (in (slice "content" "summary" "heading" "title") $indexType) -}}
    {{- errorf "unknown flexsearch index type: %s" $indexType -}}
{{- end -}}

{{- $pages := where .Site.Pages "Kind" "in" (slice "page" "section") -}}
{{- $pages = where $pages "Params.searchable" "!=" false -}} {{/* 不能直接使用 searchable 判断，防止出现 nil  */}}
{{- $pages = where $pages "Content" "!=" "" -}}

{{- $output := dict -}}

{{- range $pages -}}
    {{- $pageTitle := .LinkTitle -}} {{/* 之所以没有用 .Title 是因为 hugo 允许通过 linkTile 覆盖  */}}
    {{- if not $pageTitle -}}
        {{- with .File -}}{{- $pageTitle = .BaseFileName -}}{{- end -}} {{/* 以防万一使用文件名 */}}
    {{- end -}}
    {{- $pageLink := .RelPermalink -}}
    {{- $data := partial "function/search/fragments.html" (dict "context" . "type" $indexType) -}}
    {{- $output = $output | merge (dict $pageLink (dict "title" $pageTitle "data" $data)) -}}
{{- end -}}

{{- $output | jsonify -}}
